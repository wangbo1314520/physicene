#!/bin/bash
# 交付验证（追问1）：提交前跑类型检查+builder单测
# 【untracked 双层扫描（2026-09-20 gitignore 事故制度，第二十三轮升级）】
# ① 全仓源类未跟踪文件（ts/vue/js/py/java/sql/md/json）非空即红——换机即丢
# ② 源目录里被 .gitignore 命中的源类文件非白名单即红——data/ 规则误伤同类防线
#    （--exclude-standard 会跳过被忽略文件，故 ① 抓不到错匹配，必须独立 ②）
cd "$(git rev-parse --show-toplevel)"
UNTRACKED=$(git ls-files --others --exclude-standard -- '*.ts' '*.vue' '*.js' '*.py' '*.java' '*.sql' '*.md' '*.json')
if [ -n "$UNTRACKED" ]; then
  echo "❌ untracked 源码文件（未版本控制，换机即丢）："
  echo "$UNTRACKED"
  exit 1
fi
# 第②层实现注记：git status --ignored 只列目录级（不随 -uall 展开），故用 find+check-ignore 精确到文件
IGNORED=$(find frontend/src java-backend/src frontend/e2e python-ai-service/src python-ai-service/scripts docs \
  -type f \( -name '*.ts' -o -name '*.vue' -o -name '*.js' -o -name '*.py' -o -name '*.java' -o -name '*.sql' -o -name '*.md' \) 2>/dev/null \
  | git check-ignore --stdin 2>/dev/null | grep -avE '__pycache__|/out/|\.pyc')
if [ -n "$IGNORED" ]; then
  echo "❌ 被 .gitignore 忽略的源文件（疑似规则误伤，参照 data/ 事故）："
  echo "$IGNORED"
  exit 1
fi
cd frontend
npx vue-tsc --noEmit || { echo "❌ vue-tsc failed"; exit 1; }
npx vitest run src/builder 2>&1 | tail -3
# .gitignore 变更的提交必须过双层扫描自测（防新规则误伤——data/ 事故同型，第二十四轮制度）
if git diff --cached --name-only | grep -qx '.gitignore'; then
  bash ../.githooks/selftest.sh || exit 1
fi
echo "✅ pre-commit verify passed"
