# ========= MySQL =========
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=physicene
MYSQL_USER=physicene
MYSQL_PASSWORD=changeme_password

# ========= 后端 =========
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long_for_security
AI_INTERNAL_KEY=changeme_internal_key

# ========= AI =========
# 留空则 AI 降级（提问时提示配置 DeepSeek key）
DEEPSEEK_API_KEY=
# slim（默认，~250MB，无 OCR/RAG）或 full（~5GB，含 OCR/RAG；需另挂模型/知识库卷）
AI_MODE=slim

# ========= 前端 =========
# 如本机 80 端口被占，改成 8080 等
FRONTEND_PORT=80
