# 复制为 .env 并填入真实值（.env 已 gitignore，不进仓库）
DEEPSEEK_API_KEY=sk-xxx
INTERNAL_KEY=change-me
JAVA_BASE_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379/0
LLM_MOCK=0

# ── 以下三项可选：代码默认值即下列值，本机无需设置；仅换机器 / 容器路径不同时填写 ──
# 仓库外资源路径（项目磁盘约束：一律放 E:\Program；Linux/容器示例：/data/models/bge-m3）
# bge-m3 需事先下载：huggingface.co/BAAI/bge-m3 → BGE_M3_PATH
BGE_M3_PATH=E:\Program\models\bge-m3
# Chroma 持久化目录（data/ 已 gitignore，首次部署须运行 scripts/build_kb.py 建库）
CHROMA_DIR=data/chroma
# 教材 PDF 目录（仅建库时用）
TEXTBOOKS_DIR=E:\学习\10.论文项目
